(load "sweetie-16.au")

(define hold NIL)
(define x 0)
(define y 0)

(define setup (lambda () (begin
  (cls (sweetie 0))
)))

(define update (lambda (dt) (begin
  (if (mouse-down? 0)
  	(if hold 
			(begin
				(line x y (mouse-x) (mouse-y) (sweetie 12))
				(set! x (mouse-x))
				(set! y (mouse-y))
			)
  	  (begin
				(set! x (mouse-x))
				(set! y (mouse-y))
				(set! hold T)
			)
		)
		(set! hold NIL)
	)
)))
